{
  "name": "madcut",
  "version": "3.0.0",
  "description": "CLI tool to cut markdown file in a madly comfortable way",
  "main": "lib/madcut.js",
  "type": "module",
  "bin": {
    "madcut": "bin/madcut.js"
  },
  "exports": {
    ".": "./lib/madcut.js",
    "./plugin": "./lib/plugin.js"
  },
  "scripts": {
    "lint": "madrun lint",
    "fresh:lint": "madrun fresh:lint",
    "lint:fresh": "madrun lint:fresh",
    "fix:lint": "madrun fix:lint",
    "test": "madrun test",
    "watch:test": "madrun watch:test",
    "watch:tape": "madrun watch:tape",
    "watch:lint": "madrun watch:lint",
    "watcher": "madrun watcher",
    "coverage": "madrun coverage",
    "report": "madrun report",
    "hello": "madrun hello"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/coderaiser/madcut.git"
  },
  "keywords": [
    "madcut",
    "markdown",
    "cut",
    "tool",
    "commandline",
    "command"
  ],
  "author": "coderaiser <mnemonic.enemy@gmail.com> (http://coderaiser.github.io/)",
  "bugs": {
    "url": "https://github.com/coderaiser/madcut/issues"
  },
  "homepage": "https://github.com/coderaiser/madcut",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@putout/processor-markdown": "^13.1.1"
  },
  "devDependencies": {
    "escover": "^5.0.1",
    "eslint": "^9.39.2",
    "eslint-plugin-n": "^17.23.2",
    "eslint-plugin-putout": "^30.0.1",
    "madrun": "^12.1.0",
    "montag": "^1.2.1",
    "nodemon": "^3.0.1",
    "putout": "^41.12.0",
    "runsome": "^1.0.0",
    "supertape": "^12.0.12"
  },
  "publishConfig": {
    "access": "public"
  }
}
